{
  "$schema": "https://opencode.ai/config.json",
  "snapshot": false,
  "autoupdate": false,
  "disabled_providers": [
    "amazon-bedrock"
  ],
  "small_model": "openai/gpt-6.1-sol",
  "agent": {
    "explore": {
      "disable": true
    },
    "compaction": {
      "model": "openai/gpt-6.1-sol",
      "variant": "low"
    },
    "magic-compact-summarizer": {
      "model": "openai/gpt-6.1-sol",
      "variant": "low"
    }
  },
  "plugin": [
    "oc-arkive@5.2.0",
    "oc-multi-imagegen@1.0.0",
    "arkive-compact@1.3.0"
  ],
  "compaction": {
    "auto": false,
    "prune": false
  },
  "provider": {
    "openai": {
      "options": {
        "headerTimeout": 60000,
        "chunkTimeout": 1800000
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    }
  }
}
