{
  "mcp": {
    "ast_grep": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/ast-grep/ast-grep-mcp",
        "--with",
        "fastmcp",
        "ast-grep-server"
      ]
    },
    "context7": {
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{file:secrets/context7}"
      }
    }
  }
}
